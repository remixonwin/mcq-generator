# MCQ Generator Service Configuration

# Vault Secrets Management
VAULT_ENABLED=false
VAULT_ADDR=http://localhost:8200
VAULT_TOKEN=your-vault-token

# LLM Provider Configuration
# Router URL for LLM calls
ROUTER_URL=http://localhost:7330

# HuggingFace Token (for dataset access)
HF_TOKEN=

# Default LLM Model
LLM_MODEL=gpt-4

# Backoff Configuration
CONSECUTIVE_FAILURE_LIMIT=
BACKOFF_INITIAL_SECONDS=30
BACKOFF_MULTIPLIER=2
BACKOFF_MAX_SECONDS=1800
BACKOFF_TRIGGER=50

# Text Column Detection
TEXT_COLUMN_WHITELIST=title,headline,summary,abstract,description,prompt,question,text,content,body

# Redis Configuration
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
