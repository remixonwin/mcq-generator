# Engine Configuration
# Copy this file to .env and fill in your actual values

# =============================================================================
# Port Configuration
# =============================================================================
# Fixed port for the LLM Router - DO NOT CHANGE unless you know what you're doing
# Apps depend on this port being consistent
PORT=7543
FALLBACK_PORT=7543

# =============================================================================
# Router URL (for client examples/tests)
# =============================================================================
ROUTER_URL=http://localhost:7544

# =============================================================================
# API Settings
# =============================================================================
DEBUG=false
CORS_ORIGINS=*

# Database
GRACE_DB_PATH=data/mcqs.duckdb

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# LLM Configuration
LLM_PROVIDER=ollama
LLM_MODEL=llama3.2
LLM_API_KEY=your_llm_api_key_here
LLM_BASE_URL=http://localhost:11434
OLLAMA_API_BASE=http://localhost:11434

# Cache Settings
ENABLE_CACHE=true
CACHE_TTL=3600

# Limits
MAX_QUESTIONS_PER_REQUEST=20
MAX_BATCH_FILES=10

# API Keys
HF_TOKEN=your_huggingface_token_here
GROQ_API_KEY=your_groq_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here

GEMINI_API_KEY=your_gemini_api_key_here

# Quota management
QUOTA_STRATEGY=time_aware  # Options: aggressive, balanced, conservative, time_aware
PEAK_HOURS_START=9
PEAK_HOURS_END=17
