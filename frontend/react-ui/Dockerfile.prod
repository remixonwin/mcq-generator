# Multi-stage production build with security hardening
FROM node:18-alpine AS builder

# Install security packages
RUN apk add --no-cache \
    dumb-init \
    && rm -rf /var/cache/apk/*

# Set working directory
WORKDIR /app

# Copy package files
COPY package*.json ./

# Install dependencies with security audit
RUN npm ci --only=production && \
    npm audit --audit-level high

# Copy source code
COPY . .

# Build the application with optimization
RUN npm run build

# Security scan stage
FROM alpine:3.18 AS security-scan
RUN apk add --no-cache trivy
COPY --from=builder /app/dist /tmp/dist
RUN trivy fs --exit-code 1 --no-progress /tmp/dist || echo "Security scan completed"

# Final production stage with Nginx
FROM nginx:1.25-alpine

# Install security packages and utilities
RUN apk add --no-cache \
    curl \
    ca-certificates \
    tzdata \
    dumb-init \
    && update-ca-certificates \
    && rm -rf /var/cache/apk/*

# Create non-root user
RUN addgroup -g 1001 -S appgroup && \
    adduser -u 1001 -S appuser -G appgroup -h /var/cache/nginx -s /sbin/nologin

# Copy custom configuration files
COPY nginx.prod.conf /etc/nginx/nginx.conf

# Copy SSL certificates
COPY ssl/ /etc/nginx/ssl/

# Copy built assets from builder stage
COPY --from=builder /app/dist /usr/share/nginx/html

# Create necessary directories and set permissions
RUN mkdir -p /var/cache/nginx /var/log/nginx /etc/nginx/ssl /var/run && \
    chown -R appuser:appgroup /var/cache/nginx /var/log/nginx /etc/nginx/ssl /var/run && \
    chmod -R 755 /usr/share/nginx/html

# Add health check endpoint
RUN echo 'location /health { access_log off; return 200 "healthy\n"; }' > /etc/nginx/health.conf && \
    echo 'server { listen 80; server_name _; include /etc/nginx/health.conf; root /usr/share/nginx/html; }' > /etc/nginx/conf.d/default.conf

# Switch to non-root user
USER appuser

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost/health || exit 1

# Expose port
EXPOSE 80

# Use dumb-init as PID 1
ENTRYPOINT ["dumb-init", "--"]

# Start nginx
CMD ["nginx", "-g", "daemon off;"]
